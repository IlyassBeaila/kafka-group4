{
  "uid": "kafka-api-data",
  "title": "Kafka – Topic api-data",
  "timezone": "browser",
  "schemaVersion": 36,
  "version": 1,
  "refresh": "10s",
  "panels": [
    {
      "type": "timeseries",
      "title": "Messages par seconde (api-data)",
      "datasource": "Prometheus",
      "fieldConfig": { "defaults": {}, "overrides": [] },
      "targets": [
        {
          "expr": "rate(kafka_server_brokertopicmetrics_messagesin_total{topic=\"api-data\"}[1m])",
          "legendFormat": "msg/s"
        }
      ],
      "gridPos": { "x": 0, "y": 0, "w": 24, "h": 8 }
    }
  ],
  "time": { "from": "now-15m", "to": "now" }
}
